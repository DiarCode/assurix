{
  "suite_name": "secure",
  "version": "1.0",
  "test_cases": [
    {
      "id": "iv_path_001",
      "category": "input_validation",
      "target_url": "http://benchmark.local/secure/iv_path_001",
      "expected_findings": [
        {
          "title": "Path traversal via encoded characters",
          "severity": "high",
          "cwe_id": "CWE-22",
          "category": "input_validation"
        }
      ],
      "expected_safe": false,
      "timeout_seconds": 120
    },
