# Assurix Environment Configuration
# Copy this file to .env and adjust values for your local setup

# Database
DATABASE_URL=sqlite+aiosqlite:///data/assurix.db

# Ollama LLM Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_FAST_MODEL=mistral:7b
OLLAMA_REASONING_MODEL=qwen2.5-coder:14b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Browser Automation
MAX_BROWSER_CONTEXTS=2
PLAYWRIGHT_HEADLESS=true

# Rate Limiting & Safety
DEFAULT_RATE_RPS=10.0
MAX_ITERATIONS_PER_SCAN=50
SAFE_MODE=true

# Storage
ARTIFACTS_DIR=./data/artifacts

# Logging
LOG_LEVEL=INFO
ENV=development

# API Server
API_HOST=0.0.0.0
API_PORT=8000
