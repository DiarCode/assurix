# Assurix Environment Configuration
# Copy this file to .env and adjust values for your local setup

# Database
DATABASE_URL=sqlite+aiosqlite:///data/assurix.db

# Ollama LLM Configuration (single-model architecture: deepseek-v4-pro for ALL tasks)
OLLAMA_HOST=https://ollama.com
OLLAMA_FAST_MODEL=deepseek-v4-pro
OLLAMA_REASONING_MODEL=deepseek-v4-pro
OLLAMA_EXPLOITATION_MODEL=deepseek-v4-pro
OLLAMA_NUM_CTX=8192
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Frontier LLM APIs (optional — leave empty to use Ollama only)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
FRONTIER_REASONING_MODEL=claude-sonnet-4-6
FRONTIER_EXPLOITATION_MODEL=claude-opus-4-6

# Browser Automation
MAX_BROWSER_CONTEXTS=2
PLAYWRIGHT_HEADLESS=true

# Rate Limiting & Safety
DEFAULT_RATE_RPS=10.0
MAX_ITERATIONS_PER_SCAN=50
SAFE_MODE=true

# Storage
ARTIFACTS_DIR=./data/artifacts

# Logging
LOG_LEVEL=INFO
ENV=development

# API Server
API_HOST=0.0.0.0
API_PORT=8000
